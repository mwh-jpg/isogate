# ===== 必填安全配置 =====
# ENCRYPTION_KEY 必须恰好 32 字节（AES-256），生成: openssl rand -hex 16 取前32字符
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# JWT_SECRET 至少 32 字节
JWT_SECRET=replace-with-random-hex-64-chars-min-32
# 认证回调/OAuth重定向唯一来源，禁止信任 Host 头
PUBLIC_BASE_URL=http://localhost:8080

# ===== 数据库 / 缓存 =====
DATABASE_URL=postgres://iso:isopass@localhost:5432/isogw?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ===== 服务 =====
ADDR=:8080
DEBUG=false
TRUSTED_PROXIES=

# ===== 网关行为（Fail-Closed）=====
REQUIRE_PROXY_DEFAULT=true
MAX_UPSTREAM_BODY=16777216
UPSTREAM_TIMEOUT=300s
PROBE_MAX_BODY=1048576
COOLDOWN_429=30s
COOLDOWN_5XX=60s
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== SSRF =====
ALLOW_PRIVATE_UPSTREAM=false

# ===== compose 用 =====
PG_USER=iso
PG_PASSWORD=isopass
PG_DB=isogw
